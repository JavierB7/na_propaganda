# Bitácora de Difusión — variables de entorno
# Copiar a .env.local y llenar. .env.local nunca se versiona.

# ── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API

# URL del proyecto. Pública: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima. Pública: viaja al navegador.
# No es un secreto — los datos los protege la seguridad a nivel de fila (RLS),
# no el hecho de que esta clave sea difícil de conseguir.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SECRETA: pasa por encima de RLS.
# Solo para las tareas programadas de respaldo y ping. Nunca con prefijo
# NEXT_PUBLIC_, nunca importada desde un componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Acceso ──────────────────────────────────────────────────────────────────
# Quién tiene acceso NO se configura acá: está en la tabla
# `usuario_autorizado`, que es la misma lista que sostiene las políticas de
# RLS. Ver el README.
#
# URL pública del despliegue. La usa el enlace de acceso por correo para
# saber a dónde devolver al usuario.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Tareas programadas ──────────────────────────────────────────────────────
# Secreto compartido que autentica las llamadas a /api/cron/*. Generar con:
#   openssl rand -hex 32
CRON_SECRET=
